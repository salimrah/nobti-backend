<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ma.noba</groupId>
        <artifactId>noba-backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>noba-app</artifactId>
    <name>noba-app</name>

    <dependencies>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-admin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-announcement</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-badge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-booking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-employee</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-identity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-loyalty</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-media</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-packagegift</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-payment</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-promotion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-providernetwork</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-qa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-referral</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-reminder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-statement</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-subscription</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ma.noba</groupId>
            <artifactId>noba-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.37.3</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.3</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>noba-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Load the repo-root .env (spring.config.import) when running locally. -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <url>${env.SPRING_DATASOURCE_URL}</url>
                    <user>${env.SPRING_DATASOURCE_USERNAME}</user>
                    <password>${env.SPRING_DATASOURCE_PASSWORD}</password>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration</location>
                    </locations>
                    <baselineOnMigrate>true</baselineOnMigrate>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
